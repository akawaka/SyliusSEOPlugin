{% set context = hookable_metadata.context %}
{% set base = {type: context.type, locale: context.locale, missing: context.missing_only ? 1 : 0} %}

<div class="page-body">
    <div class="container-xl">
        <form method="get" class="row g-2 mb-3 align-items-center">
            <div class="col-auto">
                <select name="type" class="form-select" onchange="this.form.submit()">
                    {% for item in ['product', 'taxon'] %}
                        <option value="{{ item }}" {{ item == context.type ? 'selected' }}>{{ ('akawaka_seo.audit.type.' ~ item)|trans }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-auto">
                <select name="locale" class="form-select" onchange="this.form.submit()">
                    {% for item in context.locales %}
                        <option value="{{ item }}" {{ item == context.locale ? 'selected' }}>{{ item }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-auto">
                <label class="form-check mb-0">
                    <input type="checkbox" class="form-check-input" name="missing" value="1" {{ context.missing_only ? 'checked' }} onchange="this.form.submit()">
                    <span class="form-check-label">{{ 'akawaka_seo.image_alt.missing_only'|trans }}</span>
                </label>
            </div>
            <div class="col-auto text-muted">{{ 'akawaka_seo.image_alt.total'|trans({'%count%': context.total}) }}</div>
        </form>

        <form method="post" class="card" data-image-alt-form>
            <input type="hidden" name="_token" value="{{ context.token }}">
            {% if context.images is empty %}
                <div class="card-body text-success">{{ 'akawaka_seo.image_alt.none'|trans }}</div>
            {% else %}
                <div class="table-responsive">
                    <table class="table table-vcenter card-table">
                        <thead>
                            <tr>
                                <th style="width: 90px"></th>
                                <th>{{ 'akawaka_seo.audit.subject'|trans }}</th>
                                <th>{{ 'akawaka_seo.image_alt.alt'|trans }} ({{ context.locale }})</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for image in context.images %}
                                {% set owner = image.owner %}
                                <tr data-image-alt-row="{{ image.id }}">
                                    <td><span class="avatar avatar-lg" style="background-image: url('{{ image.path|imagine_filter('sylius_small') }}')"></span></td>
                                    <td>
                                        <a href="{{ path('sylius_admin_' ~ context.type ~ '_update', {id: owner.id}) }}">{{ owner.name }}</a>
                                    </td>
                                    <td>
                                        <input type="text" class="form-control {{ context.alts[image.path] is not defined ? 'is-invalid' }}" maxlength="255" name="alt[{{ image.id }}]" value="{{ context.alts[image.path]|default('') }}" placeholder="{{ owner.name }}">
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                <div class="card-footer d-flex justify-content-between align-items-center">
                    <button type="submit" class="btn btn-primary">{{ 'sylius.ui.save_changes'|trans }}</button>
                    <div class="btn-group">
                        {% if context.page > 1 %}<a class="btn" href="?{{ base|merge({page: context.page - 1})|url_encode }}">‹</a>{% endif %}
                        <span class="btn disabled">{{ context.page }} / {{ context.pages }}</span>
                        {% if context.page < context.pages %}<a class="btn" href="?{{ base|merge({page: context.page + 1})|url_encode }}">›</a>{% endif %}
                    </div>
                </div>
            {% endif %}
        </form>
    </div>
</div>
