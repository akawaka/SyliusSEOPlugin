{% from '@SyliusAdmin/shared/helper/breadcrumbs.html.twig' import breadcrumbs %}
{% import '@SyliusAdmin/shared/helper/header.html.twig' as header %}

{% set title = hookable_metadata.context.title %}

<div class="page-header d-print-none" data-sticky-header>
    <div class="container-xl">
        {{ breadcrumbs([
            { name: 'sylius.ui.dashboard', 'url': path('sylius_admin_dashboard'), 'active': false },
            { name: title, 'active': true },
        ]) }}
        <div class="row mt-3 row-gap-2">
            <div class="col-12 col-md">
                {{ header.h1(title|trans, null, null) }}
            </div>
            <div class="col-12 col-md-auto ms-auto d-print-none">
                <div class="btn-list">
                    <button type="button" class="btn btn-primary" data-audit-image-alt-save disabled>
                        {{ ux_icon('tabler:device-floppy', {class: 'icon'}) }}
                        {{ 'sylius.ui.save_changes'|trans }}
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
