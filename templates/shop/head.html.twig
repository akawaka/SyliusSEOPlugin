{% set seo = akawaka_seo_metadata() %}
{% if seo %}
    {% set subject = akawaka_seo_subject() %}
    {% set ogImage = seo.ogImage %}
    {% if not ogImage and subject.images is defined and subject.images|length > 0 %}
        {% set ogImage = absolute_url(subject.images.first.path|imagine_filter('sylius_shop_product_original')) %}
    {% endif %}
    {% if seo.description %}<meta name="description" content="{{ seo.description }}">{% endif %}
    <meta name="robots" content="{{ seo.robots }}">
    {% if seo.canonicalUrl %}<link rel="canonical" href="{{ seo.canonicalUrl }}">{% endif %}
    {% for code, url in seo.alternates %}
        <link rel="alternate" hreflang="{{ code }}" href="{{ url }}">
    {% endfor %}
    <meta property="og:type" content="{{ seo.ogType }}">
    <meta property="og:site_name" content="{{ seo.siteName }}">
    <meta property="og:locale" content="{{ seo.ogLocale }}">
    <meta property="og:title" content="{{ seo.ogTitle }}">
    {% if seo.ogDescription %}<meta property="og:description" content="{{ seo.ogDescription }}">{% endif %}
    {% if seo.canonicalUrl %}<meta property="og:url" content="{{ seo.canonicalUrl }}">{% endif %}
    {% if ogImage %}<meta property="og:image" content="{{ ogImage }}">{% endif %}
    <meta name="twitter:card" content="{{ ogImage ? 'summary_large_image' : 'summary' }}">
    <meta name="twitter:title" content="{{ seo.ogTitle }}">
    {% if seo.ogDescription %}<meta name="twitter:description" content="{{ seo.ogDescription }}">{% endif %}
    {% if ogImage %}<meta name="twitter:image" content="{{ ogImage }}">{% endif %}
    {% if subject %}
        <script type="application/ld+json">{{ akawaka_seo_json_ld(subject, seo, ogImage) }}</script>
    {% endif %}
{% else %}
    {# A page of the CMS plugin prints its own meta tags: only the structured data is added. #}
    {% set cmsPage = akawaka_seo_subject() %}
    {% if cmsPage %}
        <script type="application/ld+json">{{ akawaka_seo_json_ld(cmsPage) }}</script>
    {% endif %}
{% endif %}
